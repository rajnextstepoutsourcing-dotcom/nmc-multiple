# NMC Tool — Environment Variables
# Copy to .env for local dev. Set these in Render dashboard for production.

# Redis (from Render Redis instance — Internal URL)
REDIS_URL=redis://localhost:6379

# PostgreSQL (from Render DB — Internal Connection String)
DATABASE_URL=postgresql://user:pass@host:5432/nextstep

# NextStep internal auth token (set same value on all NextStep services)
NEXTSTEP_INTERNAL_TOKEN=change-this-to-a-strong-secret

# NMC specific
TWOCAPTCHA_API_KEY=your-2captcha-key
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_STRONG=gemini-2.5-pro
